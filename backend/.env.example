# ============================================================
# Ferramentaria AVB — Variáveis de Ambiente
# ============================================================
# Copie este arquivo para .env e preencha os valores.
# Variáveis marcadas com [OBRIGATÓRIO] são essenciais para o sistema funcionar.
# Variáveis marcadas com [OPCIONAL] possuem fallback padrão.

# ─── Supabase [OBRIGATÓRIO] ─────────────────────────────────
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_KEY=sua-anon-key-aqui

# ─── OpenAI [OBRIGATÓRIO] ───────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini           # [OPCIONAL] Modelo padrão: gpt-4o-mini

# ─── Evolution API / WhatsApp [OBRIGATÓRIO] ─────────────────
EVOLUTION_API_URL=https://sua-evolution-api.com
EVOLUTION_API_KEY=sua-api-key
EVOLUTION_INSTANCE=nome-da-instancia

# ─── IDs do WhatsApp [OBRIGATÓRIO] ──────────────────────────
GRUPO_JID=120363429173808883@g.us   # JID do grupo de notificações
AGENTE_JID=5511999999999@s.whatsapp.net  # JID do número do agente

# ─── Segurança [OBRIGATÓRIO em produção] ────────────────────
API_KEY=sua-chave-secreta-para-frontend
WEBHOOK_SECRET=seu-secret-para-webhooks

# ─── CORS [OPCIONAL] ────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,https://seu-dominio.vercel.app

# ─── Redis [OPCIONAL] ───────────────────────────────────────
# Se não configurado, o sistema usa fallback síncrono automático.
REDIS_URL=redis://default:senha@host:porta

# ─── Servidor [OPCIONAL] ────────────────────────────────────
PORT=8001
